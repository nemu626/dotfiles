[user]
	email = yamada0626@gmail.com
	name = nemu626
    # name = Your Name
    # email = your.email@example.com

[init]
    defaultBranch = main

[core]
    editor = nvim
    pager = cat
    autocrlf = input
    whitespace = fix

[color]
    ui = auto

[pull]
    rebase = true

[push]
    default = current
    autoSetupRemote = true

[fetch]
    prune = true

[rebase]
    autoStash = true

[merge]
    conflictstyle = zdiff3

[diff]
    colorMoved = default
    algorithm = histogram



[alias]
    # Status
    s = status -sb

    # Switch
    sw = switch
    sc = switch -c
    
    # Commit
    c = commit
    cm = commit -m
    ca = commit --amend
    can = commit --amend --no-edit
    
    # Branch
    b = branch
    bd = branch -d
    bD = branch -D
    
    # Checkout
    co = checkout
    cob = checkout -b
    
    # Diff
    d = diff
    ds = diff --staged
    
    # Log
    l = log --oneline -20
    lg = log --graph --oneline --decorate
    ll = log --graph --pretty=format:'%C(yellow)%h%Creset %C(auto)%d%Creset %s %C(dim)(%cr) %C(blue)<%an>%Creset'
    
    # Stash
    st = stash
    stp = stash pop
    stl = stash list
    
    # Reset
    unstage = reset HEAD --
    undo = reset --soft HEAD~1
    
    # Utility
    aliases = config --get-regexp alias
    branches = branch -a
    remotes = remote -v
    contributors = shortlog -sn
    publish = "!git push --set-upstream origin \"$(git rev-parse --abbrev-ref HEAD)\""
    tree = log --graph --oneline --decorate --all

[url "git@github.com:"]
    insteadOf = gh:

[url "git@gitlab.com:"]
    insteadOf = gl:
[credential "https://github.com"]
	helper = 
	helper = !/home/narugal/.local/share/mise/installs/github-cli/2.96.0/gh_2.96.0_linux_amd64/bin/gh auth git-credential
